# Platform-held secrets (never expose these in browser code)
OPENAI_API_KEY=sk-...
RUMIK_API_KEY=rk_...
RUMIK_GATEWAY_URL=https://silk-api.rumik.ai

# LiveKit Cloud
LIVEKIT_URL=wss://project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# Models
LLM_MODEL=gpt-4o
STT_MODEL=gpt-4o-transcribe
RUMIK_TTS_MODEL=muga
RUMIK_TTS_SPEAKER=speaker_1

# Neon Postgres and local demo proxy. The KYC proxy reads only
# PLATFORM_URL and DEMO_PLATFORM_KEY from this combined deployment file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DEMO_PLATFORM_KEY=rk_live_demo
PLATFORM_URL=http://127.0.0.1:8000

# Vision sampling policy
VISION_MAX_FPS=2
IMAGE_MAX_SIDE=1024
JPEG_QUALITY=70
BURST_COUNT=5
BURST_WINDOW_MS=1500
MAX_FRAMES_PER_MIN=40

# Broker
SESSION_TOKEN_TTL_SEC=300
MAX_CONCURRENT_SESSIONS=4
